# Application
APP_ENV=development
APP_NAME=Algo Workflow Automation
APP_VERSION=1.0.0

# Backend
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database
# SQLite is the default for the hackathon prototype.
DATABASE_URL=sqlite:///./data/workflows.db

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Optional email integration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional LLM integration
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Workflow execution
DEFAULT_RETRY_COUNT=3
DEFAULT_RETRY_DELAY_SECONDS=2
MAX_PYTHON_EXECUTION_SECONDS=5
